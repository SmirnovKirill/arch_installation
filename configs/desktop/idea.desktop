[Desktop Entry]
Name=Idea
# Отделяем IDEA от управляющего терминала и группы рабочего стола:
# интерактивный bash при получении окружения ИИ-агентом может остановить общую группу сигналом SIGTTIN.
Exec=/usr/bin/setsid -f /usr/bin/intellij-idea-ultimate-edition %u
Type=Application
Icon=intellij-idea-ultimate-edition
